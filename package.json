{
  "name": "x6-vue-html-shape",
  "version": "0.0.0",
  "description": "X6 Vue shape extension without SVG foreignObject, rendering Vue nodes in an HTML overlay layer.",
  "keywords": [
    "antv",
    "foreignObject",
    "html",
    "safari",
    "shape",
    "vue",
    "x6"
  ],
  "homepage": "https://x6-vue-html-shape.ntnyq.dev",
  "bugs": {
    "url": "https://github.com/ntnyq/x6-vue-html-shape/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ntnyq/x6-vue-html-shape.git"
  },
  "files": [
    "dist",
    "src/style.css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/style.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./style.css": "./src/style.css",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs build",
    "docs:dev": "pnpm -C docs dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck test",
    "release:version": "bumpp",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@antv/x6": "^3.1.8",
    "@ntnyq/tsconfig": "^3.1.0",
    "@ntnyq/utils": "^0.27.0",
    "@types/node": "^26.6.7",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "5.1.1",
    "bumpp": "^12.3.0",
    "eslint-plugin-ntnyq": "^0.21.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.1.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "playwright": "1.65.1",
    "tsdown": "^0.23.7",
    "tsnapi": "^1.6.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@antv/x6": "^3.0.1",
    "vue": "^3.3.0"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.23.0"
}
