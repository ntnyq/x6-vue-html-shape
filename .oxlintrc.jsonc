{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "import",
    "jsdoc",
    "node",
    "promise",
    "oxc",
    "typescript",
    "unicorn",
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off",
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/__snapshots__/**",
  ],
  "rules": {
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"],
      },
    ],
    "func-style": [
      "warn",
      "declaration",
      {
        "allowArrowFunctions": true,
      },
    ],
    "id-length": [
      "warn",
      {
        "min": 2,
        "exceptions": ["_", "$", "i", "j", "k", "x", "y", "z", "T", "N"],
      },
    ],
    "max-statements": ["warn", 100],
    "max-lines-per-function": [
      "warn",
      { "max": 200, "skipComments": true, "skipBlankLines": true },
    ],
    "no-duplicate-imports": [
      "warn",
      { "includeExports": true, "allowSeparateTypeImports": true },
    ],
    "no-magic-numbers": [
      "warn",
      {
        "ignore": [0, 1, -1, 2, 10, 100, 1000],
        "ignoreArrayIndexes": true,
        "enforceConst": true,
        "detectObjects": false,
      },
    ],
    "one-var": ["error", "never"],
  },
  "overrides": [
    {
      "files": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"],
      "jsPlugins": [
        {
          "name": "ntnyq",
          "specifier": "eslint-plugin-ntnyq",
        },
      ],
      "rules": {
        "ntnyq/padding-line-between-statements": [
          "error",
          // The last matching entry wins, so exceptions follow their general rules.
          {
            "blankLine": "always",
            "prev": "*",
            "next": [
              "if",
              "for",
              "while",
              "do",
              "switch",
              "try",
              "return",
              "throw",
            ],
          },
          {
            "blankLine": "always",
            "prev": ["if", "for", "while", "do", "switch", "try"],
            "next": "*",
          },
          {
            "blankLine": "always",
            "prev": ["const", "let", "var"],
            "next": "*",
          },
          {
            "blankLine": "any",
            "prev": ["const", "let", "var"],
            "next": ["const", "let", "var"],
          },
          {
            "blankLine": "always",
            "prev": "*",
            "next": ["function", "class"],
          },
          {
            "blankLine": "always",
            "prev": ["function", "class"],
            "next": "*",
          },
          {
            "blankLine": "always",
            "prev": "import",
            "next": "*",
          },
          {
            "blankLine": "never",
            "prev": "import",
            "next": "import",
          },
        ],
      },
    },
    {
      "files": ["*.config.{ts,mjs}", "**/config.ts"],
      "rules": {
        "sort-keys": "warn",
      },
    },
    {
      "files": ["*.{spec,test}.{js,ts,tsx}", "*.{spec,test}-d.{ts,tsx}"],
      "plugins": ["vitest"],
      "rules": {
        "id-length": "off",
        "no-magic-numbers": "off",
        "vitest/require-mock-type-parameters": "off",
      },
    },
  ],
}
